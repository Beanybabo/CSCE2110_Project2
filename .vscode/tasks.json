{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: build campus project",
      "command": "/usr/bin/g++",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "-std=c++11",
        "-I${workspaceFolder}/Include",
        "${workspaceFolder}/src/*.cpp",
        "-o",
        "${workspaceFolder}/campus"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Builds every .cpp file in src/ into ./campus"
    }
  ]
}